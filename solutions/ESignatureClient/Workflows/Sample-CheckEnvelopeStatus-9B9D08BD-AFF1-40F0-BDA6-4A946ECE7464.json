{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cs_esignbrokerconnection"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "cs_BrokerServiceEnvironment (cs_BrokerServiceEnvironment)": {
          "defaultValue": "https://goc-wetv14.crm3.dynamics.com",
          "type": "String",
          "metadata": {
            "schemaName": "cs_BrokerServiceEnvironment",
            "description": "The Dataverse environment URL for the E-Signature Broker Service"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "Envelope ID",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "The cs_envelopeid of the envelope to check",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Initialize_RequestedAt": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "RequestedAt",
                "type": "string",
                "value": "@{utcNow()}"
              }
            ]
          },
          "runAfter": {}
        },
        "Initialize_PollCount": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "PollCount",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Initialize_RequestedAt": [
              "Succeeded"
            ]
          }
        },
        "Request_Broker_Status_Check": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecordWithOrganization",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "organization": "@parameters('cs_BrokerServiceEnvironment (cs_BrokerServiceEnvironment)')",
              "entityName": "cs_envelopes",
              "recordId": "@triggerBody()?['text']",
              "item/cs_statuscheckrequestedon": "@variables('RequestedAt')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Initialize_PollCount": [
              "Succeeded"
            ]
          },
          "description": "Requests the broker environment to call Nintex and refresh this envelope status."
        },
        "Wait_For_Broker_Refresh": {
          "type": "Until",
          "expression": "@or(greaterOrEquals(ticks(coalesce(outputs('Get_Envelope_After_Refresh')?['body/cs_statuslastcheckedon'], '1900-01-01T00:00:00Z')), ticks(variables('RequestedAt'))), greaterOrEquals(variables('PollCount'), 12))",
          "limit": {
            "count": 12,
            "timeout": "PT1M"
          },
          "actions": {
            "Delay_5_Seconds": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 5,
                  "unit": "Second"
                }
              },
              "runAfter": {}
            },
            "Get_Envelope_After_Refresh": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItemWithOrganization",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "organization": "@parameters('cs_BrokerServiceEnvironment (cs_BrokerServiceEnvironment)')",
                  "entityName": "cs_envelopes",
                  "recordId": "@triggerBody()?['text']"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Delay_5_Seconds": [
                  "Succeeded"
                ]
              }
            },
            "Increment_PollCount": {
              "type": "IncrementVariable",
              "inputs": {
                "name": "PollCount",
                "value": 1
              },
              "runAfter": {
                "Get_Envelope_After_Refresh": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Request_Broker_Status_Check": [
              "Succeeded"
            ]
          },
          "description": "Polls until the broker writes cs_statuslastcheckedon for this request, or until the bounded timeout is reached."
        },
        "Get_Envelope": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItemWithOrganization",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "organization": "@parameters('cs_BrokerServiceEnvironment (cs_BrokerServiceEnvironment)')",
              "entityName": "cs_envelopes",
              "recordId": "@triggerBody()?['text']"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Wait_For_Broker_Refresh": [
              "Succeeded"
            ]
          },
          "description": "Retrieves the refreshed envelope record. Terminal statuses use inactive reasons: 5=Completed, 8=Cancelled, 10=Declined, 11=Expired, 717640008=Staled, 717640009=Signer Authentication Failed."
        },
        "List_Signers": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecordsWithOrganization",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "organization": "@parameters('cs_BrokerServiceEnvironment (cs_BrokerServiceEnvironment)')",
              "entityName": "cs_signers",
              "$filter": "_cs_envelopelookup_value eq @{triggerBody()?['text']}",
              "$orderby": "cs_signerorder asc"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Get_Envelope": [
              "Succeeded"
            ]
          },
          "description": "Lists all signers for this envelope with their current status."
        },
        "List_Documents": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecordsWithOrganization",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "organization": "@parameters('cs_BrokerServiceEnvironment (cs_BrokerServiceEnvironment)')",
              "entityName": "cs_documents",
              "$filter": "_cs_envelopelookup_value eq @{triggerBody()?['text']}",
              "$orderby": "cs_documentorder asc"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Get_Envelope": [
              "Succeeded"
            ]
          },
          "description": "Lists all documents attached to this envelope."
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
